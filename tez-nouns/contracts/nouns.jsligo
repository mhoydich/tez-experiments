// tez-nouns — FA2 NFT with earned + living traits
// jsLIGO (LIGO >= 1.x). Template-grade: readable over gas-golfed.

type token_id = nat;

type seed = {
  background: nat,
  body: nat,
  head: nat,
  glasses: nat,
  accessory: nat,   // EARNED: derived from stamps registry at mint
  aura: nat,        // LIVING: mutable post-mint
};

type series = | ["Personal"] | ["Auction"];

type noun = {
  seed: seed,
  series: series,
  minted_at: timestamp,
  last_poke: timestamp,
};

type storage = {
  admin: address,
  stamps_registry: address,        // tez-stamps contract
  next_id: token_id,
  ledger: big_map<token_id, address>,
  nouns: big_map<token_id, noun>,
  personal_minted: big_map<address, token_id>,
  // trait inventory sizes for random slots
  pool_sizes: { background: nat, body: nat, head: nat, glasses: nat, aura: nat },
  // earned-accessory rule table: (stamp_id needed) -> accessory pool [start, len]
  accessory_rules: big_map<nat, [nat, nat]>,
  default_accessory_pool: [nat, nat],
  // qualifying stamp for personal mint
  qualifying_stamp: nat,
  // on-chain art: (layer_name, index) packed key -> RLE bytes
  art: big_map<[string, nat], bytes>,
  decay_period: int,               // seconds of inactivity before aura decays
  metadata: big_map<string, bytes>,
};

type ret = [list<operation>, storage];

// ---------- pseudo-randomness ----------
// Good enough for trait assignment on a template; NOT for high-value lotteries.
const roll = (entropy: bytes, salt: nat, modulo: nat): nat => {
  const h = Crypto.blake2b(Bytes.concat(entropy, Bytes.pack(salt)));
  return match(Bytes.unpack(Bytes.sub(0n, 4n, h)) as option<nat>) {
    when (Some(n)): n % modulo;
    when (None()): salt % modulo
  };
};

// ---------- earned accessory ----------
const derive_accessory = (s: storage, who: address, entropy: bytes): nat => {
  // Walk the rule table by stamp id: highest qualifying stamp id wins.
  // (Template keeps rules small; iterate a known id range.)
  let pool = s.default_accessory_pool;
  let i = 0n;
  while (i < 32n) {
    match(Big_map.find_opt(i, s.accessory_rules)) {
      when (Some(p)): do {
        const held = match(Tezos.call_view("has_stamp", [who, i], s.stamps_registry)
                           as option<bool>) {
          when (Some(b)): b;
          when (None()): false
        };
        if (held) pool = p;
      };
      when (None()): unit
    };
    i = i + 1n;
  };
  const [start, len] = pool;
  return start + roll(entropy, 99n, len);
};

// ---------- mint ----------
@entry
const mint = (kind: series, s: storage): ret => {
  const who = Tezos.get_sender();
  const id = s.next_id;

  match(kind) {
    when (Personal()): do {
      if (Big_map.mem(who, s.personal_minted)) failwith("ONE_PER_WALLET");
      const qualifies = match(Tezos.call_view(
        "has_stamp", [who, s.qualifying_stamp], s.stamps_registry) as option<bool>) {
        when (Some(b)): b;
        when (None()): false
      };
      if (!qualifies) failwith("EARN_YOUR_NOUN");
    };
    when (Auction()): do {
      if (Tezos.get_sender() != s.admin) failwith("NOT_AUCTION_HOUSE");
    }
  };

  const entropy = Bytes.pack([Tezos.get_now(), who, id]);
  const seed: seed = {
    background: roll(entropy, 1n, s.pool_sizes.background),
    body:       roll(entropy, 2n, s.pool_sizes.body),
    head:       roll(entropy, 3n, s.pool_sizes.head),
    glasses:    roll(entropy, 4n, s.pool_sizes.glasses),  // sacred, always random
    accessory:  derive_accessory(s, who, entropy),         // earned
    aura:       0n,                                        // born bright
  };

  const n: noun = { seed, series: kind, minted_at: Tezos.get_now(), last_poke: Tezos.get_now() };
  const personal_minted = match(kind) {
    when (Personal()): Big_map.add(who, id, s.personal_minted);
    when (Auction()): s.personal_minted
  };

  return [list([]), {
    ...s,
    next_id: id + 1n,
    ledger: Big_map.add(id, who, s.ledger),
    nouns: Big_map.add(id, n, s.nouns),
    personal_minted,
  }];
};

// ---------- aura lifecycle ----------

@entry
const poke = (id: token_id, s: storage): ret => {
  const owner = match(Big_map.find_opt(id, s.ledger)) {
    when (Some(a)): a; when (None()): failwith("NO_NOUN")
  };
  if (Tezos.get_sender() != owner) failwith("NOT_OWNER");
  const n = match(Big_map.find_opt(id, s.nouns)) {
    when (Some(x)): x; when (None()): failwith("NO_NOUN")
  };
  const refreshed = { ...n, last_poke: Tezos.get_now(), seed: { ...n.seed, aura: 0n } };
  return [list([]), { ...s, nouns: Big_map.update(id, Some(refreshed), s.nouns) }];
};

// Permissionless keeper: anyone can decay a neglected noun's aura one step.
@entry
const decay = (id: token_id, s: storage): ret => {
  const n = match(Big_map.find_opt(id, s.nouns)) {
    when (Some(x)): x; when (None()): failwith("NO_NOUN")
  };
  if (Tezos.get_now() < n.last_poke + s.decay_period) failwith("STILL_BRIGHT");
  const dimmer = n.seed.aura + 1n >= s.pool_sizes.aura ? n.seed.aura : n.seed.aura + 1n;
  const dimmed = { ...n, last_poke: Tezos.get_now(), seed: { ...n.seed, aura: dimmer } };
  return [list([]), { ...s, nouns: Big_map.update(id, Some(dimmed), s.nouns) }];
};

@entry
const grant_aura = (p: { id: token_id, aura: nat }, s: storage): ret => {
  if (Tezos.get_sender() != s.admin) failwith("NOT_ADMIN"); // hand to DAO later
  const n = match(Big_map.find_opt(p.id, s.nouns)) {
    when (Some(x)): x; when (None()): failwith("NO_NOUN")
  };
  const granted = { ...n, seed: { ...n.seed, aura: p.aura } };
  return [list([]), { ...s, nouns: Big_map.update(p.id, Some(granted), s.nouns) }];
};

// ---------- admin: art + rules ----------

@entry
const set_art = (p: { layer: string, index: nat, rle: bytes }, s: storage): ret => {
  if (Tezos.get_sender() != s.admin) failwith("NOT_ADMIN");
  return [list([]), { ...s, art: Big_map.update([p.layer, p.index], Some(p.rle), s.art) }];
};

@entry
const set_accessory_rule = (p: { stamp_id: nat, pool: [nat, nat] }, s: storage): ret => {
  if (Tezos.get_sender() != s.admin) failwith("NOT_ADMIN");
  return [list([]), { ...s, accessory_rules: Big_map.update(p.stamp_id, Some(p.pool), s.accessory_rules) }];
};

// ---------- FA2 transfer (nouns ARE transferable, unlike stamps) ----------

type transfer_dest = { to_: address, token_id: token_id, amount: nat };
type transfer_item = { from_: address, txs: list<transfer_dest> };

@entry
const transfer = (ts: list<transfer_item>, s: storage): ret => {
  let ledger = s.ledger;
  for (const t of ts) {
    for (const d of t.txs) {
      if (d.amount != 1n) failwith("FA2_INSUFFICIENT_BALANCE");
      const owner = match(Big_map.find_opt(d.token_id, ledger)) {
        when (Some(a)): a; when (None()): failwith("FA2_TOKEN_UNDEFINED")
      };
      if (owner != t.from_ || Tezos.get_sender() != owner)
        failwith("FA2_NOT_OWNER");
      ledger = Big_map.update(d.token_id, Some(d.to_), ledger);
    }
  };
  return [list([]), { ...s, ledger }];
};

// ---------- views ----------

@view
const get_noun = (id: token_id, s: storage): noun =>
  match(Big_map.find_opt(id, s.nouns)) {
    when (Some(n)): n; when (None()): failwith("NO_NOUN")
  };

@view
const get_art = (k: [string, nat], s: storage): bytes =>
  match(Big_map.find_opt(k, s.art)) {
    when (Some(b)): b; when (None()): failwith("NO_ART")
  };

// ---------- token_metadata view (TZIP-12 shape, TZIP-21 keys) ----------
// Mirrors src/metadata.js. Michelson can't stringify at runtime, so the
// whole pipeline works in bytes: decimal digits, SVG fragments, and the
// data URI are all bytes-literal concats. One <rect> per RLE run (format:
// [paletteIndex, runLength] pairs, row-major 32x32; palette 0 = skip),
// so the SVG stays compact. '#' in colors is %23-escaped for the URI.

const nat_to_dec = (n: nat): bytes => {
  if (n == 0n) return bytes`30`; // "0"
  let acc = bytes``;
  let m = n;
  while (m > 0n) {
    const d = m % 10n;
    const digit =
      d == 0n ? bytes`30` : d == 1n ? bytes`31` : d == 2n ? bytes`32` :
      d == 3n ? bytes`33` : d == 4n ? bytes`34` : d == 5n ? bytes`35` :
      d == 6n ? bytes`36` : d == 7n ? bytes`37` : d == 8n ? bytes`38` : bytes`39`;
    acc = Bytes.concat(digit, acc);
    m = m / 10n;
  };
  return acc;
};

// Palette from art/manifest.json, '#' pre-escaped as %23 for the data URI.
const palette_hex = (i: nat): bytes =>
  i == 1n ? bytes`253233643564376531` /* "%23d5d7e1" */ : i == 2n ? bytes`253233653164376435` /* "%23e1d7d5" */ :
  i == 3n ? bytes`253233316631643239` /* "%231f1d29" */ : i == 4n ? bytes`253233306636316666` /* "%230f61ff" */ :
  i == 5n ? bytes`253233623334303261` /* "%23b3402a" */ : i == 6n ? bytes`253233663361303032` /* "%23f3a002" */ :
  i == 7n ? bytes`253233326139643866` /* "%232a9d8f" */ : i == 8n ? bytes`253233666666666666` /* "%23ffffff" */ :
  i == 9n ? bytes`253233313033313265` /* "%2310312e" */ : bytes``;

const px: nat = 10n;
const grid: nat = 32n;

// Emit rects for one RLE-encoded layer, splitting runs at row boundaries.
const layer_rects = (rle: bytes): bytes => {
  let out = bytes``;
  let i = 0n;
  let pos = 0n;
  const len = Bytes.length(rle);
  while (i + 1n < len + 1n && i + 2n <= len) {
    const c = nat(Bytes.sub(i, 1n, rle));
    let run = nat(Bytes.sub(i + 1n, 1n, rle));
    i = i + 2n;
    if (c == 0n) { pos = pos + run; run = 0n; }
    while (run > 0n) {
      const x = pos % grid;
      const y = pos / grid;
      const row_left = abs(grid - x);
      const w = run < row_left ? run : row_left;
      out = Bytes.concats(list([
        out,
        bytes`3c7265637420783d27` /* "<rect x='" */, nat_to_dec(x * px),
        bytes`2720793d27` /* "' y='" */, nat_to_dec(y * px),
        bytes`272077696474683d27` /* "' width='" */, nat_to_dec(w * px),
        bytes`27206865696768743d27` /* "' height='" */, nat_to_dec(px),
        bytes`272066696c6c3d27` /* "' fill='" */, palette_hex(c), bytes`272f3e` /* "'/>" */,
      ]));
      pos = pos + w;
      run = abs(run - w);
    };
  };
  return out;
};

const layer_svg = (s: storage, layer: string, idx: nat): bytes =>
  match(Big_map.find_opt([layer, idx], s.art)) {
    when (Some(rle)): layer_rects(rle);
    when (None()): bytes``
  };

const compose_svg = (s: storage, sd: seed): bytes =>
  Bytes.concats(list([
    bytes`646174613a696d6167652f7376672b786d6c3b757466382c` /* "data:image/svg+xml;utf8," */,
    bytes`3c73766720786d6c6e733d27687474703a2f2f7777772e77332e6f72672f323030302f737667272077696474683d2733323027206865696768743d27333230272073686170652d72656e646572696e673d2763726973704564676573273e` /* "<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320' shape-rendering='crispEdges'>" */,
    layer_svg(s, "background", sd.background),
    layer_svg(s, "body", sd.body),
    layer_svg(s, "accessory", sd.accessory),
    layer_svg(s, "head", sd.head),
    layer_svg(s, "glasses", sd.glasses),
    layer_svg(s, "aura", sd.aura),
    bytes`3c2f7376673e` /* "</svg>" */,
  ]));

type token_metadata_ret = { token_id: nat, token_info: map<string, bytes> };

@view
const token_metadata = (id: token_id, s: storage): token_metadata_ret => {
  const n = match(Big_map.find_opt(id, s.nouns)) {
    when (Some(x)): x; when (None()): failwith("NO_NOUN")
  };
  const series_b = match(n.series) {
    when (Personal()): bytes`706572736f6e616c` /* "personal" */;
    when (Auction()): bytes`61756374696f6e` /* "auction" */
  };
  const attributes = Bytes.concats(list([
    bytes`5b7b226e616d65223a22736572696573222c2276616c7565223a22` /* "[{"name":"series","value":"" */, series_b, bytes`227d2c` /* ""}," */,
    bytes`7b226e616d65223a226261636b67726f756e64222c2276616c7565223a22` /* "{"name":"background","value":"" */, nat_to_dec(n.seed.background), bytes`227d2c` /* ""}," */,
    bytes`7b226e616d65223a22626f6479222c2276616c7565223a22` /* "{"name":"body","value":"" */, nat_to_dec(n.seed.body), bytes`227d2c` /* ""}," */,
    bytes`7b226e616d65223a2268656164222c2276616c7565223a22` /* "{"name":"head","value":"" */, nat_to_dec(n.seed.head), bytes`227d2c` /* ""}," */,
    bytes`7b226e616d65223a22676c6173736573222c2276616c7565223a22` /* "{"name":"glasses","value":"" */, nat_to_dec(n.seed.glasses), bytes`227d2c` /* ""}," */,
    bytes`7b226e616d65223a226163636573736f7279222c2276616c7565223a22` /* "{"name":"accessory","value":"" */, nat_to_dec(n.seed.accessory), bytes`227d2c` /* ""}," */,
    bytes`7b226e616d65223a2261757261222c2276616c7565223a22` /* "{"name":"aura","value":"" */, nat_to_dec(n.seed.aura), bytes`227d5d` /* ""}]" */,
  ]));
  const info = Map.literal(list([
    ["name", Bytes.concat(bytes`54657a204e6f756e20` /* "Tez Noun " */, nat_to_dec(id))],
    ["description", bytes`4f6e65206e6f756e2c206561726e65642e204163636573736f727920646572697665732066726f6d20746865206d696e7465722773207374616d70733b206175726120697320616c6976652e` /* "One noun, earned. Accessory derives from the minter's stamps; aura is alive." */],
    ["decimals", bytes`30`],
    ["isBooleanAmount", bytes`74727565` /* "true" */],
    ["artifactUri", compose_svg(s, n.seed)],
    ["attributes", attributes],
  ]));
  return { token_id: id, token_info: info };
};
